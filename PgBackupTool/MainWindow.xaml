<Window x:Class="PgBackupTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PgBackupTool.Views"
        Title="PgBackupTool" Height="620" Width="960"
        MinHeight="500" MinWidth="760"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        Background="#1E1E2E"
        Icon="/Assets/logo.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>

        <Style x:Key="ProfileListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Foreground" Value="#89B4FA"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#292940"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#F38BA8"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Main area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane: profile list -->
            <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#313244">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Image Source="/Assets/logo.png" Width="22" Height="22" Margin="0,0,7,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="PROFILES" FontSize="11" FontWeight="Bold"
                                       Foreground="#A6ADC8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ProfileListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                    <TextBlock Text="{Binding Database}" FontSize="11" Foreground="#6C7086" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8">
                        <Button Content="+ Add"
                                Style="{StaticResource IconButton}"
                                Command="{Binding AddProfileCommand}"
                                ToolTip="Add new profile"/>
                        <Button Content="- Remove"
                                Style="{StaticResource IconButton}"
                                Margin="6,0,0,0"
                                Command="{Binding RemoveProfileCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                ToolTip="Remove selected profile"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#313244" ResizeBehavior="PreviousAndNext"/>

            <!-- Right pane -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Profile details + action buttons -->
                <Border Grid.Row="0" Background="#181825" Padding="16,12"
                        BorderBrush="#313244" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   FontSize="16" FontWeight="Bold" Foreground="#CDD6F4"
                                   Margin="0,0,0,10"
                                   Text="{Binding SelectedProfile.Name, FallbackValue='No profile selected'}"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="Host"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}"
                                       Text="{Binding SelectedProfile.Host, FallbackValue='—'}"/>

                            <Label Grid.Column="3" Content="Port"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource DetailValue}"
                                       Text="{Binding SelectedProfile.Port, FallbackValue='—'}"/>

                            <Label Grid.Column="6" Content="Database"/>
                            <TextBlock Grid.Column="7" Style="{StaticResource DetailValue}"
                                       Text="{Binding SelectedProfile.Database, FallbackValue='—'}"/>

                            <Label Grid.Column="9" Content="User"/>
                            <TextBlock Grid.Column="10" Style="{StaticResource DetailValue}"
                                       Text="{Binding SelectedProfile.Username, FallbackValue='—'}"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="Backup Now"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding BackupNowCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Edit"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding EditProfileCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Delete Profile"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding RemoveProfileCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Backup history -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#313244" Padding="12,0">
                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#A6ADC8">
                            <Run Text="BACKUP HISTORY"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding SelectedProfile.Name, FallbackValue=''}"/>
                        </TextBlock>
                    </Border>

                    <views:BackupHistoryView Grid.Row="1"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Log pane -->
        <Border Grid.Row="1" Background="#11111B" BorderBrush="#313244" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#313244" Padding="12,0">
                    <DockPanel>
                        <TextBlock Text="LOG" FontSize="11" FontWeight="Bold"
                                   Foreground="#A6ADC8" VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <Button Content="Cancel"
                                DockPanel.Dock="Right"
                                Style="{StaticResource DangerButton}"
                                Height="22" Padding="10,2"
                                Margin="0,3"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="#11111B">
                    <TextBox x:Name="LogTextBox"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11"
                             Background="Transparent"
                             Foreground="#A6E3A1"
                             BorderThickness="0"
                             Padding="10,6"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
